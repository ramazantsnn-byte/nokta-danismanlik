// ----------------------------------------------------
// 1. TOOL: YASAL SÜRE HESAPLAMA MOTORU
// ----------------------------------------------------
function runDateCalculation() {
  const vefatDateInput = document.getElementById('vefat-date').value;
  const lokasyon = document.getElementById('mirasci-lokasyon').value;
  const dayDisplay = document.getElementById('calc-day-val');
  const statusText = document.getElementById('calc-status-text');
  const adviceText = document.getElementById('calc-advice');
  const waBtn = document.getElementById('calc-wa-action');

  if (!vefatDateInput) {
    dayDisplay.textContent = '--';
    statusText.textContent = 'Lütfen Vefat Tarihini Seçin';
    return;
  }

  const vefatDate = new Date(vefatDateInput);
  const today = new Date();

  let ayCount = 4;
  if (lokasyon === '6_tr' || lokasyon === '6_yd') ayCount = 6;
  if (lokasyon === '8') ayCount = 8;

  const deadline = new Date(vefatDate);
  deadline.setMonth(deadline.getMonth() + ayCount);

  const diffTime = deadline - today;
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

  if (diffDays > 0) {
    dayDisplay.textContent = diffDays;
    dayDisplay.style.color = diffDays < 30 ? '#C59B27' : '#16A34A';
    statusText.textContent = `Yasal Süre İçindesiniz: ${diffDays} Gün Kaldı`;
    statusText.style.color = diffDays < 30 ? '#C59B27' : '#16A34A';
    adviceText.textContent = `Son Beyan Tarihiniz: ${deadline.toLocaleDateString('tr-TR')}. Cezai faiz doğmadan dosyanızı vergi dairesine sunmak için süreci başlatalım.`;
    waBtn.href = `https://wa.me/905538525308?text=Merhaba%2C%20vefat%20tarihimiz%20${vefatDateInput}%20ve%20kalan%20g%C3%BCn%C3%BCm%C3%BCz%20${diffDays}.%20Dosyam%C4%B1z%C4%B1%20h%C4%B1zla%20ba%C5%9Flatmak%20istiyoruz.`;
  } else {
    const expiredDays = Math.abs(diffDays);
    dayDisplay.textContent = `+${expiredDays}`;
    dayDisplay.style.color = '#B42132';
    statusText.textContent = 'Yasal Süre Aşılmış Durumda (Gecikmeli)';
    statusText.style.color = '#B42132';
    adviceText.textContent = `Yasal süreniz ${expiredDays} gün önce dolmuş. Vergi cezası ve gecikme faizi büyümeden, 15 günlük ek süre kalkanı ve uzlaşma imkanları için derhal müdahale edelim.`;
    waBtn.href = `https://wa.me/905538525308?text=Merhaba%2C%20vefat%20tarihimiz%20${vefatDateInput}.%20Yasal%20s%C3%BCre%20ge%C3%A7mi%C5%9F%20durumda%2C%20acil%20dan%C4%B1%C5%9Fmanl%C4%B1k%20almak%20istiyorum.`;
  }
}

