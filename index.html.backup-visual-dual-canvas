// ----------------------------------------------------
// 4. UNIFIED 7-SLIDE CAROUSEL (VIDEO + 6 SERVICES)
// AUTO-FLOW + INTERACTIVE MOUSE DRAG & TOUCH SWIPE
// ----------------------------------------------------
(function initUnifiedHeroCarousel() {
  const stageBox = document.getElementById("heroStageBox");
  const track = document.getElementById("heroLayerTrack");
  const viewport = document.getElementById("heroLayerViewport");
  const video = document.getElementById("heroStageVideo");
  const cards = document.querySelectorAll(".hero-layer-card");
  const dots = document.querySelectorAll("#heroLayerDots .h-dot");

  let currentIndex = 0;
  const total = cards.length;
  let slideTimer = null;
  let isHovered = false;
  let isDragging = false;
  let startX = 0;
  let dragDiff = 0;
  let isPointerDown = false;

  function goToSlide(idx, animate = true) {
    currentIndex = (idx + total) % total;
    if (track) {
      track.style.transition = animate ? "transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)" : "none";
      track.style.transform = "translateX(-" + (currentIndex * 100) + "%)";
    }

    dots.forEach((dot, dIdx) => {
      dot.classList.toggle("active", dIdx === currentIndex);
    });

    if (currentIndex === 0 && video) {
      video.currentTime = 0;
      video.play().catch(() => {});
    }

    scheduleNext();
  }

  function nextSlide() {
    goToSlide(currentIndex + 1);
  }

  function prevSlide() {
    goToSlide(currentIndex - 1);
  }

  function scheduleNext() {
    clearTimeout(slideTimer);
    if (isHovered || isDragging) return;

    if (currentIndex === 0) {
      // Slayt 0 (Video): Video bitince (ended) veya 10 saniye sonra sonraki slayta geçer
    } else {
      // Hizmet Slaytları 1..6: 2.8 saniye durup otomatik kayar
      slideTimer = setTimeout(() => {
        nextSlide();
      }, 2800);
    }
  }

  // Video ended -> geçiş
  if (video) {
    video.addEventListener("ended", () => {
      if (currentIndex === 0 && !isHovered && !isDragging) {
        nextSlide();
      }
    });

    // 10.2 saniyede video bitmiş olmalı
    setInterval(() => {
      if (currentIndex === 0 && video.currentTime >= 9.8 && !isHovered && !isDragging) {
        nextSlide();
      }
    }, 1000);
  }

  // Hover Pause
  if (stageBox) {
    stageBox.addEventListener("mouseenter", () => {
      isHovered = true;
      clearTimeout(slideTimer);
    });
    stageBox.addEventListener("mouseleave", () => {
      isHovered = false;
      scheduleNext();
    });
  }

  // Arrow buttons
  const prevBtn = document.getElementById("heroStagePrev");
  const nextBtn = document.getElementById("heroStageNext");
  if (prevBtn) {
    prevBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      prevSlide();
    });
  }
  if (nextBtn) {
    nextBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      nextSlide();
    });
  }

  // Dots click
  dots.forEach(dot => {
    dot.addEventListener("click", (e) => {
      e.preventDefault();
      const idx = parseInt(dot.getAttribute("data-index") || "0", 10);
      goToSlide(idx);
    });
  });

  // MOUSE DRAG & TOUCH SWIPE
  function dragStart(e) {
    isPointerDown = true;
    isDragging = true;
    clearTimeout(slideTimer);
    startX = e.type.includes("mouse") ? e.clientX : e.touches[0].clientX;
    dragDiff = 0;
    if (track) track.style.transition = "none";
  }

  function dragMove(e) {
    if (!isPointerDown) return;
    const currentX = e.type.includes("mouse") ? e.clientX : e.touches[0].clientX;
    dragDiff = currentX - startX;
    const vpWidth = viewport ? viewport.offsetWidth : 400;
    const offsetPercent = (dragDiff / vpWidth) * 100;
    const baseTranslate = -(currentIndex * 100);
    if (track) {
      track.style.transform = "translateX(" + (baseTranslate + offsetPercent) + "%)";
    }
  }

  function dragEnd() {
    if (!isPointerDown) return;
    isPointerDown = false;
    isDragging = false;

    if (Math.abs(dragDiff) > 45) {
      if (dragDiff > 0) {
        prevSlide();
      } else {
        nextSlide();
      }
    } else {
      goToSlide(currentIndex);
    }
  }

  if (viewport) {
    // Mouse Drag
    viewport.addEventListener("mousedown", dragStart);
    window.addEventListener("mousemove", dragMove);
    window.addEventListener("mouseup", dragEnd);

    // Touch Swipe
    viewport.addEventListener("touchstart", dragStart, { passive: true });
    viewport.addEventListener("touchmove", dragMove, { passive: true });
    viewport.addEventListener("touchend", dragEnd, { passive: true });
  }

  goToSlide(0);
})();
</script>


