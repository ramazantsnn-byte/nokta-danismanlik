let currentFlow = 'intikal';
let currentStepIdx = 0;

function selectFlowTab(flowKey) {
  currentFlow = flowKey;
  currentStepIdx = 0;
  
  // Update Tab buttons
  document.querySelectorAll('.flow-tab-btn').forEach(btn => btn.classList.remove('active'));
  if (window.event && window.event.currentTarget) {
    window.event.currentTarget.classList.add('active');
  }
  
  // Render steps in pipeline
  const data = FLOW_DATA[flowKey];
  for (let i = 0; i < 4; i++) {
    const step = data.steps[i];
    const iconEl = document.getElementById('node-icon-' + (i + 1));
    const titleEl = document.getElementById('node-title-' + (i + 1));
    const placeEl = document.getElementById('node-place-' + (i + 1));
    if (iconEl) iconEl.innerText = step.icon;
    if (titleEl) titleEl.innerText = step.title;
    if (placeEl) placeEl.innerText = step.place;
  }
  
  updateNodeHud(0);
}

function selectNodeStep(idx) {
  currentStepIdx = idx;
  updateNodeHud(idx);
}

function updateNodeHud(idx) {
  // Update active state in pipeline
  document.querySelectorAll('.node-item').forEach((item, i) => {
    if (i === idx) item.classList.add('active');
    else item.classList.remove('active');
  });

  const step = FLOW_DATA[currentFlow].steps[idx];
  const tagEl = document.getElementById('hudStepTag');
  const titleEl = document.getElementById('hudStepTitle');
  const descEl = document.getElementById('hudStepDesc');
  const timeEl = document.getElementById('hudSpecTime');
  const roleEl = document.getElementById('hudSpecRole');
  
  if (tagEl) tagEl.innerText = step.tag;
  if (titleEl) titleEl.innerText = step.mainTitle;
  if (descEl) descEl.innerText = step.desc;
  if (timeEl) timeEl.innerText = step.time;
  if (roleEl) roleEl.innerText = step.role;

  // Update WA Link
  const waBtn = document.getElementById('hudWaBtn');
  if (waBtn) {
    const rawMsg = 'Merhaba Nokta Danışmanlık, ' + step.title + ' aşamasındayım (' + step.place + '). Süreç takibi için destek almak istiyorum.';
    waBtn.href = 'https://wa.me/905538525308?text=' + encodeURIComponent(rawMsg);
  }
}

function switchWorld(mode) {
  const tabNokta = document.getElementById('tab-nokta');
  const tabCile = document.getElementById('tab-cile');
  const contentNokta = document.getElementById('world-nokta-content');
  const contentCile = document.getElementById('world-cile-content');

  if (mode === 'nokta') {
    if (tabNokta) tabNokta.className = 'two-worlds-tab active-nokta';
    if (tabCile) tabCile.className = 'two-worlds-tab';
    if (contentNokta) contentNokta.style.display = 'block';
    if (contentCile) contentCile.style.display = 'none';
  } else {
    if (tabCile) tabCile.className = 'two-worlds-tab active-cile';
    if (tabNokta) tabNokta.className = 'two-worlds-tab';
    if (contentNokta) contentNokta.style.display = 'none';
    if (contentCile) contentCile.style.display = 'block';
  }
}

// Magnetic Button Physics
document.addEventListener('DOMContentLoaded', () => {
  const magneticBtns = document.querySelectorAll('.magnetic-btn');
  magneticBtns.forEach(btn => {
    btn.addEventListener('mousemove', (e) => {
      const rect = btn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      btn.style.transform = 'translate(' + (x * 0.22) + 'px, ' + (y * 0.22) + 'px)';
    });
    btn.addEventListener('mouseleave', () => {
      btn.style.transform = 'translate(0px, 0px)';
    });
  });
});
